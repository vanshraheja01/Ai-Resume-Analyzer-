# --- App ---
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000

# --- Database ---
# Matches docker-compose.yml defaults. Change if you run your own Postgres instance.
DATABASE_URL=postgresql+psycopg://resume_user:resume_pass@localhost:5432/resume_analyzer

# --- Auth ---
# Generate your own with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=replace-with-a-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Storage ---
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./storage/uploads
MAX_UPLOAD_SIZE_MB=5

# --- AI ---
# mock requires no API key at all and is the default; switch to live once you have a Gemini key.
AI_MODE=mock
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
